{
  "name": "pocketfinance",
  "version": "0.1.0",
  "private": true,
  "description": "PocketFinance personal-finance mobile application.",
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:generate": "npm run db:generate --workspace=@pocketfinance/api",
    "db:validate": "npm run db:validate --workspace=@pocketfinance/api",
    "db:migrate": "npm run db:migrate --workspace=@pocketfinance/api",
    "db:deploy": "npm run db:deploy --workspace=@pocketfinance/api",
    "db:status": "npm run db:status --workspace=@pocketfinance/api",
    "db:seed": "npm run db:seed --workspace=@pocketfinance/api",
    "categories:init": "node --env-file=.env --import tsx apps/api/src/categories/initialize.ts",
    "icons:generate": "node --import tsx scripts/generate-category-icons.mjs",
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "node --env-file=.env --import \"data:text/javascript,process.env.NODE_ENV='development'\" --import tsx --watch apps/api/src/index.ts",
    "dev:mobile": "npm run dev --workspace=@pocketfinance/mobile",
    "start:api": "node --env-file=.env --import tsx apps/api/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=@pocketfinance/api && npm run test:integration --workspace=@pocketfinance/mobile",
    "test:integration:local": "node --env-file=.env scripts/test-integration-local.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
