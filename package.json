{
  "name": "pocketledger",
  "version": "0.1.0",
  "private": true,
  "description": "PocketLedger personal-finance mobile application.",
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "npm run db:generate --workspace=@pocketledger/api",
    "db:validate": "npm run db:validate --workspace=@pocketledger/api",
    "db:migrate": "npm run db:migrate --workspace=@pocketledger/api",
    "db:deploy": "npm run db:deploy --workspace=@pocketledger/api",
    "db:status": "npm run db:status --workspace=@pocketledger/api",
    "db:seed": "npm run db:seed --workspace=@pocketledger/api",
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@pocketledger/api",
    "dev:mobile": "npm run dev --workspace=@pocketledger/mobile",
    "start:api": "node --env-file=.env --import tsx apps/api/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=@pocketledger/api && npm run test:integration --workspace=@pocketledger/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
