generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionDirection {
  income
  expense
}

enum ImportStatus {
  pending
  confirmed
  failed
}

enum AuthProvider {
  google
}

enum AccountType {
  cash
  bank
  credit
  other
}

model User {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String              @unique @db.VarChar(254)
  // Null for Google-only accounts; never invent a password for social login.
  passwordHash       String?             @db.Text
  emailVerifiedAt    DateTime?           @db.Timestamptz(3)
  disabledAt         DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  categories         Category[]
  transactions       Transaction[]
  imports            Import[]
  identities         AuthIdentity[]
  sessions           Session[]
  financePreferences FinancePreferences?
  accounts           Account[]
}

model FinancePreferences {
  userId           String   @id @db.Uuid
  // Null until explicitly chosen; once set, SQL prevents changing or clearing it.
  entryCurrency    String?  @db.VarChar(3)
  defaultAccountId String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  defaultAccount   Account? @relation(fields: [defaultAccountId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict, map: "FinancePreferences_default_account_owner_fkey")
}

model Account {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String               @db.Uuid
  name                String               @db.VarChar(100)
  type                AccountType
  currency            String               @db.VarChar(3)
  openingBalanceMinor Int                  @default(0)
  openingDate         DateTime             @db.Date
  archivedAt          DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  defaultFor          FinancePreferences[]
  transactions        Transaction[]

  @@unique([id, userId])
  // Active normalized-name uniqueness lives in the hand-written partial index.
  @@index([userId, archivedAt, id])
}

model AuthIdentity {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  // Google's verified, case-sensitive `sub`, not an email or client-supplied ID.
  providerSubject String       @db.VarChar(255)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
}

// One login on one device; also the revocation boundary for its refresh family.
model Session {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String          @db.Uuid
  expiresAt         DateTime        @db.Timestamptz(3)
  revokedAt         DateTime?       @db.Timestamptz(3)
  lastUsedAt        DateTime?       @db.Timestamptz(3)
  reauthenticatedAt DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refreshTokens     RefreshToken[]
  challenges        AuthChallenge[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

// One-time Google proof binding. Link/reauth challenges belong to one session.
model AuthChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nonceHash  String    @unique @db.VarChar(64)
  purpose    String    @db.VarChar(20)
  sessionId  String?   @db.Uuid
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  session    Session?  @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt])
  @@index([sessionId])
}

// Retain consumed hashes until the session expires to detect rotation replay.
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([sessionId])
  @@index([expiresAt])
}

model Category {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Null is the shared immutable catalog; non-null is a private personal row.
  userId       String?       @db.Uuid
  name         String        @db.VarChar(100)
  isDefault    Boolean       @default(false)
  parentId     String?       @db.Uuid
  defaultKey   String?       @db.VarChar(100)
  iconKey      String        @default("category") @db.VarChar(40)
  colorKey     String        @default("neutral") @db.VarChar(40)
  sortOrder    Int           @default(0)
  archivedAt   DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions Transaction[]
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "Category_parent_fkey")
  children     Category[]    @relation("CategoryHierarchy")

  // Personal keys are null; shared keys are globally unique (SQL checks identity).
  @@unique([defaultKey])
  // Active normalized-name uniqueness lives in the hand-written partial index.
  @@index([userId, archivedAt])
  @@index([userId, parentId, archivedAt])
}

model Transaction {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String               @db.Uuid
  // Manual API creation supplies both. Internal/generated postings may omit both.
  // SQL enforces pair consistency and immutability; hard deletion releases the key.
  clientRequestId     String?              @db.Uuid
  creationFingerprint String?              @db.VarChar(64)
  categoryId          String               @db.Uuid
  importId            String?              @db.Uuid
  accountId           String               @db.Uuid
  direction           TransactionDirection
  // Positive magnitude; direction carries the sign. SQL adds a CHECK (> 0).
  amountMinor         Int
  date                DateTime             @db.Date
  merchant            String?              @db.VarChar(200)
  note                String?              @db.VarChar(2000)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "Transaction_category_fkey")
  import              Import?              @relation(fields: [importId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  account             Account              @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict, map: "Transaction_account_owner_fkey")

  @@unique([userId, clientRequestId])
  @@index([userId, accountId, date(sort: Desc), id(sort: Desc)])
  @@index([userId, date(sort: Desc), id(sort: Desc)])
  @@index([userId, categoryId, date(sort: Desc), id(sort: Desc)])
  @@index([userId, importId])
}

// Metadata only. CSV parsing, preview storage and confirmation arrive later.
model Import {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @db.Uuid
  status       ImportStatus  @default(pending)
  confirmedAt  DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions Transaction[]

  @@unique([id, userId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
}
