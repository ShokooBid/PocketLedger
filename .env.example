# Local development configuration for compose.yaml.
# Copy this file to .env; .env is intentionally ignored by Git.
# The API reads process environment; explicitly load this file when starting it.
# No mobile application may use database credentials or server signing secrets.

POSTGRES_USER=pocketledger
POSTGRES_PASSWORD=replace-with-a-unique-local-development-password
POSTGRES_DB=pocketledger
POSTGRES_PORT=5432

# Prisma CLI reads this from the repository-root .env. Use the same password
# as POSTGRES_PASSWORD above, URL-encoded if it contains reserved characters.
# Replace the placeholder; do not use the disposable test URL for local data.
DATABASE_URL=postgresql://pocketledger:replace-with-url-encoded-local-password@localhost:5432/pocketledger

# Generate at least 32 random bytes encoded as base64url; keep the value local.
# This placeholder intentionally fails API configuration validation.
ACCESS_TOKEN_SECRET=replace-me
HOST=127.0.0.1
PORT=3000
ACCESS_TOKEN_ISSUER=pocketledger-api
ACCESS_TOKEN_AUDIENCE=pocketledger-mobile
ACCESS_TTL_SECONDS=900
SESSION_TTL_SECONDS=2592000
SESSION_IDLE_SECONDS=604800
CHALLENGE_TTL_SECONDS=300
REAUTH_TTL_SECONDS=300

# Comma-separated public OAuth IDs. Empty disables Google, leaving password auth.
# Audiences are backend/web IDs; presenters are approved native/web client IDs.
GOOGLE_CLIENT_IDS=
GOOGLE_PRESENTER_IDS=
# Exact origins, no wildcard/path/trailing slash. Production requires HTTPS origins.
# Native clients usually have no Origin header; CORS is not authentication.
CORS_ORIGINS=http://localhost:8081
# Staged currency preview. Keep false until the account-aware finance rollout.
FINANCE_CURRENCY_ENABLED=false
FINANCE_CATEGORIES_ENABLED=false

# Do not commit .env, database exports, or a production credential here.
# Never use EXPO_PUBLIC_ for secrets: those values are visible to app users.
