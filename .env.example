# Local development configuration for compose.yaml.
# Copy this file to .env; .env is intentionally ignored by Git.
# These values configure only a local PostgreSQL container. The API bootstrap
# does not load them yet, and no mobile application may use them.

POSTGRES_USER=pocketledger
POSTGRES_PASSWORD=replace-with-a-unique-local-development-password
POSTGRES_DB=pocketledger
POSTGRES_PORT=5432

# Prisma CLI reads this from the repository-root .env. Use the same password
# as POSTGRES_PASSWORD above, URL-encoded if it contains reserved characters.
# Replace the placeholder; do not use the disposable test URL for local data.
DATABASE_URL=postgresql://pocketledger:replace-with-url-encoded-local-password@localhost:5432/pocketledger

# Do not commit .env, database exports, or a production credential here.
# Never use EXPO_PUBLIC_ for secrets: those values are visible to app users.
